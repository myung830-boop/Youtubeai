{
  "name": "ai-sajang-video",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio",
    "still:poses": "remotion still PoseSheet out/pose-sheet.png",
    "render:sample": "remotion render Sample30 out/sample30.mp4",
    "brand": "for id in ProfileImage Banner Watermark ThumbnailA ThumbnailB StyleBoard ShortsFrame LongformFrame; do remotion still $id docs/brand/$id.png; done && remotion render Intro docs/brand/Intro.mp4",
    "render:ep001": "remotion render Ep001 out/ep001.mp4",
    "test-voice:ep001": "python3 scripts/make_test_voice.py"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.300",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.300"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}